            </addData>
          </task>
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PLC_PRG" pouType="program">
                <interface>
                  <inputVars>
                    <variable name="i_bStart">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i_bStop">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i_wTempSensor">
                      <type>
                        <INT />
                      </type>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="o_bHeater">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_bMixer">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_rAvgTemp">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="a_rTempHistory">
                      <type>
                        <array>
                          <dimension lower="0" upper="4" />
                          <baseType>
                            <REAL />
                          </baseType>
                        </array>
                      </type>
                    </variable>
                    <variable name="fbMixTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="i_State">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="0" />
                      </initialValue>
                    </variable>
                    <variable name="i_Index">
                      <type>
                        <INT />
                      </type>
                    </variable>
                    <variable name="r_Temp">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="r_Sum">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">r_Temp := (INT_TO_REAL(i_wTempSensor) * 150.0) / 27648.0;

FOR i_Index := 4 TO 1 BY -1 DO
    a_rTempHistory[i_Index] := a_rTempHistory[i_Index - 1];
END_FOR;

a_rTempHistory[0] := r_Temp;

r_Sum := 0.0;

FOR i_Index := 0 TO 4 DO
    r_Sum := r_Sum + a_rTempHistory[i_Index];
END_FOR;

o_rAvgTemp := r_Sum / 5.0;

IF NOT i_bStop THEN
    i_State := 0;
    o_bHeater := FALSE;
    o_bMixer := FALSE;
    fbMixTimer(IN := FALSE, PT := T#10s);
ELSE
    fbMixTimer(IN := (i_State = 2), PT := T#10s);

    CASE i_State OF

        0:
            o_bHeater := FALSE;
            o_bMixer := FALSE;

            IF i_bStart THEN
                i_State := 1;
            END_IF;

        1:
            o_bHeater := TRUE;
            o_bMixer := FALSE;

            IF o_rAvgTemp &gt; 80.0 THEN
                o_bHeater := FALSE;
                o_bMixer := TRUE;
                i_State := 2;
            END_IF;

        2:
            o_bHeater := FALSE;
            o_bMixer := TRUE;

            IF fbMixTimer.Q THEN
                o_bMixer := FALSE;
                i_State := 0;
            END_IF;

        ELSE
            i_State := 0;
            o_bHeater := FALSE;
            o_bMixer := FALSE;

    END_CASE;
END_IF;</xhtml>
                  </ST>
                </body>
