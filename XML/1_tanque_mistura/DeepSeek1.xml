          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PLC_PRG" pouType="program">
                <interface>
                  <inputVars>
                    <variable name="i_bStart">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i_bStop">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i_wTempSensor">
                      <type>
                        <INT />
                      </type>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="o_bHeater">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_bMixer">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_rAvgTemp">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="a_rTempHistory">
                      <type>
                        <array>
                          <dimension lower="1" upper="5" />
                          <baseType>
                            <REAL />
                          </baseType>
                        </array>
                      </type>
                    </variable>
                    <variable name="fbMixTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="i_State">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="0" />
                      </initialValue>
                    </variable>
                    <variable name="i_Index">
                      <type>
                        <INT />
                      </type>
                    </variable>
                    <variable name="r_TempConverted">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="r_SumTemp">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="b_EmergencyStop">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">
b_EmergencyStop := NOT i_bStop;

IF b_EmergencyStop THEN
    i_State := 0;
    fbMixTimer(IN := FALSE, PT := T#10S);
    o_bHeater := FALSE;
    o_bMixer := FALSE;
ELSE
    r_TempConverted := (INT_TO_REAL(i_wTempSensor) / 27648.0) * 150.0;

    FOR i_Index := 5 TO 2 BY -1 DO
        a_rTempHistory[i_Index] := a_rTempHistory[i_Index - 1];
    END_FOR;
    a_rTempHistory[1] := r_TempConverted;

    r_SumTemp := 0.0;
    FOR i_Index := 1 TO 5 DO
        r_SumTemp := r_SumTemp + a_rTempHistory[i_Index];
    END_FOR;
    o_rAvgTemp := r_SumTemp / 5.0;

    CASE i_State OF
        0:
            o_bHeater := FALSE;
            o_bMixer := FALSE;
            fbMixTimer(IN := FALSE, PT := T#10S);
            IF i_bStart THEN
                i_State := 1;
            END_IF;

        1:
            o_bHeater := TRUE;
            o_bMixer := FALSE;
            IF o_rAvgTemp &gt; 80.0 THEN
                o_bHeater := FALSE;
                o_bMixer := TRUE;
                fbMixTimer(IN := TRUE, PT := T#10S);
                i_State := 2;
            END_IF;

        2:
            o_bHeater := FALSE;
            o_bMixer := TRUE;
            fbMixTimer(IN := TRUE, PT := T#10S);
            IF fbMixTimer.Q THEN
                o_bMixer := FALSE;
                fbMixTimer(IN := FALSE, PT := T#10S);
                i_State := 0;
            END_IF;

        ELSE
            i_State := 0;
            o_bHeater := FALSE;
            o_bMixer := FALSE;
    END_CASE;
END_IF;</xhtml>
                  </ST>
                </body>
