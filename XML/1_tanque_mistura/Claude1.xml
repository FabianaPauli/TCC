    <configurations>
      <configuration name="Device">
        <resource name="Application">
          <task name="MainTask" interval="PT0.02S" priority="1">
            <pouInstance name="PLC_PRG" typeName="">
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml" />
              </documentation>
            </pouInstance>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/tasksettings" handleUnknown="implementation">
                <TaskSettings KindOfTask="Cyclic" Interval="t#20ms" IntervalUnit="ms" WithinSPSTimeSlicing="true">
                  <Watchdog Enabled="false" TimeUnit="ms" Sensitivity="1" />
                </TaskSettings>
              </data>
              <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                <ObjectId>b6707ae4-966c-413c-8bf6-46c98ce06af5</ObjectId>
              </data>
            </addData>
          </task>
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="PLC_PRG" pouType="program">
                <interface>
                  <inputVars>
                    <variable name="i_bStart">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i_bStop">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Contato NF: FALSE = emergencia acionada </xhtml>
                      </documentation>
                    </variable>
                    <variable name="i_wTempSensor">
                      <type>
                        <INT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Sinal bruto 0..27648 </xhtml>
                      </documentation>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="o_bHeater">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_bMixer">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="o_rAvgTemp">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="aTempHist">
                      <type>
                        <array>
                          <dimension lower="0" upper="4" />
                          <baseType>
                            <REAL />
                          </baseType>
                        </array>
                      </type>
                    </variable>
                    <variable name="tmrMix">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="iState">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="0" />
                      </initialValue>
                    </variable>
                    <variable name="iIdx">
                      <type>
                        <INT />
                      </type>
                    </variable>
                    <variable name="rTempScaled">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="rSum">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="bTmrEnable">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">
(* ===== 1. ESCALONAMENTO: 0..27648 -&gt; 0.0..150.0 degC ===== *)
rTempScaled := (INT_TO_REAL(i_wTempSensor) * 150.0) / 27648.0;

IF rTempScaled &lt; 0.0 THEN
    rTempScaled := 0.0;
ELSIF rTempScaled &gt; 150.0 THEN
    rTempScaled := 150.0;
END_IF;

(* ===== 2. MEDIA MOVEL (FOR) ===== *)
FOR iIdx := 4 TO 1 BY -1 DO
    aTempHist[iIdx] := aTempHist[iIdx - 1];
END_FOR;
aTempHist[0] := rTempScaled;

rSum := 0.0;
FOR iIdx := 0 TO 4 DO
    rSum := rSum + aTempHist[iIdx];
END_FOR;
o_rAvgTemp := rSum / 5.0;

(* ===== 4. SEGURANCA E INTERLOCKS (antes da maquina de estados) ===== *)
IF NOT i_bStop THEN
    (* Emergencia acionada: estado seguro *)
    iState     := 0;
    bTmrEnable := FALSE;
    tmrMix(IN := FALSE, PT := T#10s);
    o_bHeater  := FALSE;
    o_bMixer   := FALSE;
ELSE
    (* ===== 3. MAQUINA DE ESTADOS ===== *)
    CASE iState OF

        0: (* IDLE *)
            o_bHeater  := FALSE;
            o_bMixer   := FALSE;
            bTmrEnable := FALSE;
            IF i_bStart THEN
                iState := 1;
            END_IF;

        1: (* HEATING *)
            o_bHeater := TRUE;
            o_bMixer  := FALSE;
            IF o_rAvgTemp &gt; 80.0 THEN
                o_bHeater  := FALSE;
                o_bMixer   := TRUE;
                bTmrEnable := TRUE;
                iState     := 2;
            END_IF;

        2: (* MIXING *)
            o_bHeater := FALSE;
            o_bMixer  := TRUE;
            IF tmrMix.Q THEN
                o_bMixer   := FALSE;
                bTmrEnable := FALSE;
                iState     := 0;
            END_IF;

    ELSE
        (* Estado invalido: retorna ao estado seguro *)
        o_bHeater  := FALSE;
        o_bMixer   := FALSE;
        bTmrEnable := FALSE;
        iState     := 0;
    END_CASE;

    (* Chamada do temporizador apos a avaliacao dos estados *)
    tmrMix(IN := bTmrEnable, PT := T#10s);
END_IF;
</xhtml>
                  </ST>
                </body>
